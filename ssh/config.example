# ~/.ssh/config の雛形。案件ごとの bastion 設定は手で追記し、このリポジトリには入れない。

Host github.com
  HostName github.com
  User git
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  UseKeychain yes
  AddKeysToAgent yes

# --- 案件 bastion の書き方メモ ---
# 通常の踏み台:
# Host example-stg
#   HostName 203.0.113.10
#   User ec2-user
#   IdentityFile ~/key/example-stg-bastion.pem
#
# SSM 経由 (session-manager-plugin が必要):
# Host example-ssm
#   HostName i-0123456789abcdef0
#   User ubuntu
#   IdentityFile ~/key/example.pem
#   IdentitiesOnly yes
#   ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --profile example"
#   ServerAliveInterval 60
#   ServerAliveCountMax 3
